{
  "name": "@stanzaapi/iata-validator",
  "version": "1.0.0",
  "description": "Official zero-dependency, high-speed JavaScript/TypeScript client for IATA Air Cargo AWB & Aviation Validator",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "keywords": [
    "iata",
    "air-cargo",
    "awb",
    "aviation",
    "airline-code",
    "baggage-tag",
    "e-ticket",
    "mod-7",
    "cargo-imp"
  ],
  "author": "Stanza",
  "license": "MIT",
  "homepage": "https://stanzaapi.com/tools/iata-validator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StanzaAPI/iata-validator-typescript.git"
  }
}